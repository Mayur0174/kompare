{
  "name": "kompare",
  "version": "1.0.0",
  "private": true,
  "description": "Kompare \u2013 one app to compare prices, track price history and order across Amazon, Flipkart, Myntra and more.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "build:mobile": "VITE_API_BASE=${VITE_API_BASE:?Set VITE_API_BASE to your deployed API, e.g. https://api.example.com} npm run build && npx cap sync",
    "android": "npx cap add android || true; npm run build:mobile && npx cap open android",
    "ios": "npx cap add ios || true; npm run build:mobile && npx cap open ios"
  },
  "dependencies": {
    "compression": "1.7.5",
    "express": "4.21.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.59.20",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/android": "6.2.0",
    "@capacitor/ios": "6.2.0"
  }
}
