# Copy to web/.env (git-ignored) and fill in.
# Live, real prices from Amazon, Flipkart, Croma… (free key: https://serpapi.com → Sign up → API key)
VITE_SERPAPI_KEY=
# Google sign-in + cloud backup (Firebase, free Spark plan)
# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
VITE_GOOGLE_WEB_CLIENT_ID=
